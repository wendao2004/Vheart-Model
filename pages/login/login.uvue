<template>
	<view class="page" :class="{ 'theme-light': globalTheme.isLight.value }">
		<view class="container">
			<!-- Logo + 标题 -->
			<view class="logo-section">
				<image src="/static/logo.png" mode="aspectFit" class="logo"></image>
				<text class="app-name">Vheart-Model</text>
				<text class="app-slogan">记录你的生活</text>
			</view>

			<!-- 登录/注册切换 -->
			<view class="mode-switch">
				<text class="mode-text" :class="{ active: isLoginMode }" @tap="isLoginMode = true">登录</text>
				<text class="mode-text" :class="{ active: isLoginMode == false }" @tap="isLoginMode = false">注册</text>
			</view>

			<!-- 表单 -->
			<view class="form-section">
				<input class="input-field" type="number" placeholder="请输入手机号" placeholder-class="input-placeholder" v-model="phoneNumber" />
				<input class="input-field" type="text" password="true" placeholder="请输入密码" placeholder-class="input-placeholder" v-model="password" />
				<view v-show="isLoginMode == false">
					<input class="input-field" type="text" password="true" placeholder="请确认密码" placeholder-class="input-placeholder" v-model="confirmPassword" />
				</view>
				<view class="login-btn" @tap="handleSubmit">
					<text class="login-btn-text">{{ buttonText }}</text>
				</view>
				<text class="forgot-text">忘记密码?</text>
			</view>

			<!-- 分割线 -->
			<view class="divider">
				<view class="divider-line"></view>
				<text class="divider-text">或使用其他方式</text>
				<view class="divider-line"></view>
			</view>

			<!-- 其他登录 -->
			<view class="other-login">
				<view class="other-icon">
					<image src="/static/logo.png" mode="aspectFit" class="other-img"></image>
				</view>
				<view class="other-icon">
					<image src="/static/logo.png" mode="aspectFit" class="other-img"></image>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue';
	import { globalUser } from '@/core/model/use-user-model';
	import { globalTheme } from '@/core/model/use-theme-model';
import { LoginRequestDTO, RegisterRequestDTO } from '@/core/bean/user';

	const phoneNumber = ref('');
	const password = ref('');
	const confirmPassword = ref('');
	const isLoginMode = ref(true);

	const buttonText = computed((): string => {
		if (isLoginMode.value == true) {
			return '登录';
		}
		return '注册';
	});

	onMounted(() => {
		if (globalUser.isLogin.value == true) {
			uni.reLaunch({ url: '/pages/index/index' });
		}
	});

	async function handleSubmit() {
		// 手机号校验
		if (phoneNumber.value.length != 11) {
			uni.showToast({ title: '请输入11位手机号', icon: 'none', duration: 1000 });
			return;
		}
		// 密码校验
		if (password.value == '') {
			uni.showToast({ title: '请输入密码', icon: 'none', duration: 1000 });
			return;
		}
		// 注册模式：确认密码
		if (isLoginMode.value == false) {
			if (confirmPassword.value == '') {
				uni.showToast({ title: '请确认密码', icon: 'none', duration: 1000 });
				return;
			}
			if (password.value != confirmPassword.value) {
				uni.showToast({ title: '两次密码不一致', icon: 'none', duration: 1000 });
				return;
			}
		}

		uni.showLoading({ title: '处理中...' });
		try {
			if (isLoginMode.value == true) {
				// 登录
				const req = { phoneNumber: phoneNumber.value, password: password.value } as LoginRequestDTO;
				await globalUser.login(req);
			uni.hideLoading();
			uni.showToast({ title: '登录成功', icon: 'success', duration: 1000 });
			uni.reLaunch({ url: '/pages/index/index' });
		} else {
				// 注册
				const req = { phoneNumber: phoneNumber.value, password: password.value } as RegisterRequestDTO;
				await globalUser.register(req);
				uni.hideLoading();
				uni.showToast({ title: '注册成功，请登录', icon: 'success', duration: 1000 });
				isLoginMode.value = true;
				confirmPassword.value = '';
			}
		} catch (error: any) {
			uni.hideLoading();
			const msg = error.message != null && error.message != '' ? error.message : '操作失败';
			uni.showToast({ title: msg as string, icon: 'none', duration: 1000 });
		}
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		width: 100%;
		background-color: #0c121e;
	}

	.container {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 48rpx;
		padding-top: 120rpx;
	}

	/* ========== Logo ========== */
	.logo-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 60rpx;
	}

	.logo {
		width: 160rpx;
		height: 160rpx;
		margin-bottom: 24rpx;
	}

	.app-name {
		font-size: 44rpx;
		font-weight: 700;
		color: #ffffff;
		margin-bottom: 8rpx;
	}

	.app-slogan {
		font-size: 26rpx;
		color: rgba(255, 255, 255, 0.4);
	}

	/* ========== 模式切换 ========== */
	.mode-switch {
		display: flex;
		flex-direction: row;
		height: 72rpx;
		border-radius: 36rpx;
		background-color: rgba(255, 255, 255, 0.06);
		padding: 6rpx;
		margin-bottom: 40rpx;
		width: 320rpx;
	}

	.mode-text {
		flex: 1;
		text-align: center;
		line-height: 60rpx;
		font-size: 28rpx;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.45);
		border-radius: 30rpx;

		&.active {
			color: #ffffff;
			font-weight: 700;
			background-color: #3c86fe;
		}
	}

	/* ========== 表单 ========== */
	.form-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.input-field {
		width: 100%;
		height: 96rpx;
		background-color: rgba(255, 255, 255, 0.07);
		border-radius: 20rpx;
		padding: 0 32rpx;
		font-size: 28rpx;
		color: #ffffff;
		margin-bottom: 24rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: rgba(255, 255, 255, 0.08);
		box-sizing: border-box;
	}

	.input-placeholder {
		color: rgba(255, 255, 255, 0.3);
		font-size: 28rpx;
	}

	.login-btn {
		width: 100%;
		height: 96rpx;
		background-color: #3c86fe;
		border-radius: 20rpx;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-top: 16rpx;
		margin-bottom: 24rpx;
	}

	.login-btn-text {
		font-size: 32rpx;
		font-weight: 700;
		color: #ffffff;
	}

	.forgot-text {
		font-size: 26rpx;
		color: #3c86fe;
		align-self: flex-end;
	}

	/* ========== 分割线 ========== */
	.divider {
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;
		margin: 48rpx 0 32rpx;
	}

	.divider-line {
		flex: 1;
		height: 1rpx;
		background-color: rgba(255, 255, 255, 0.1);
	}

	.divider-text {
		padding: 0 24rpx;
		font-size: 24rpx;
		color: rgba(255, 255, 255, 0.35);
	}

	/* ========== 其他登录 ========== */
	.other-login {
		display: flex;
		flex-direction: row;
		justify-content: center;
	}

	.other-icon {
		width: 96rpx;
		height: 96rpx;
		border-radius: 48rpx;
		background-color: rgba(255, 255, 255, 0.07);
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0 24rpx;
	}

	.other-img {
		width: 48rpx;
		height: 48rpx;
	}

	/* ========== 浅色主题覆盖 ========== */
	.theme-light {
		background-color: #f0f2f5;
	}
	.theme-light .app-name { color: #1a1a2e; }
	.theme-light .app-slogan { color: rgba(26,26,46,0.5); }
	.theme-light .mode-switch { background-color: rgba(0,0,0,0.05); }
	.theme-light .mode-text { color: rgba(26,26,46,0.45); }
	.theme-light .mode-text.active { color: #ffffff; }
	.theme-light .input-field { background-color: #ffffff; color: #1a1a2e; border-color: rgba(0,0,0,0.1); }
	.theme-light .input-placeholder { color: rgba(26,26,46,0.3); }
	.theme-light .forgot-text { color: #3c86fe; }
	.theme-light .divider-line { background-color: rgba(0,0,0,0.1); }
	.theme-light .divider-text { color: rgba(26,26,46,0.35); }
	.theme-light .other-icon { background-color: #ffffff; }
	.theme-light .logo { /* logo 图片不变 */ }
</style>





