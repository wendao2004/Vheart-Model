<template>
	<view class="page" :class="{ 'theme-light': globalTheme.isLight.value }">
		<scroll-view scroll-y class="scroll-content">
			<!-- 顶部问候 -->
			<view class="header">
				<view class="greeting">
					<text class="greeting-text">{{ greetingText }}</text>
					<text class="user-name">{{ nickname }}</text>
				</view>
				<view class="date-badge">
					<text class="date-text">{{ dateText }}</text>
				</view>
			</view>

			<!-- 搜索栏 -->
			<view class="search-bar">
				<text class="search-icon">🔍</text>
				<input type="text" placeholder="搜索物品、模型..." placeholder-class="search-placeholder" class="search-input" />
			</view>

			<!-- 快捷入口 -->
			<view class="section">
				<view class="section-header">
					<text class="section-title">快捷入口</text>
				</view>
				<scroll-view scroll-x class="quick-scroll" show-scrollbar="false">
					<view class="quick-list">
						<view v-for="(item, index) in quickList" :key="index" class="quick-card" :style="{ background: item.gradient }">
							<text class="quick-icon">{{ item.icon }}</text>
							<text class="quick-title">{{ item.title }}</text>
							<text class="quick-desc">{{ item.desc }}</text>
						</view>
					</view>
				</scroll-view>
			</view>

			<!-- 最近记录 -->
			<view class="section">
				<view class="section-header">
					<text class="section-title">最近记录</text>
					<text class="section-more">查看全部 ›</text>
				</view>
				<view class="recent-list">
					<view v-for="(item, index) in recentList" :key="index" class="recent-card">
						<view class="recent-thumb" :style="{ background: item.gradient }">
							<text class="recent-thumb-text">{{ item.emoji }}</text>
						</view>
						<view class="recent-info">
							<text class="recent-title">{{ item.title }}</text>
							<text class="recent-meta">{{ item.category }} · {{ item.date }}</text>
						</view>
						<text class="recent-arrow">›</text>
					</view>
				</view>
			</view>

			<!-- 底部留白 -->
			<view style="height: 40rpx;"></view>
		</scroll-view>
		<app-tab-bar current="index" />
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue';
	import { globalUser } from '../../core/model/use-user-model';
	import { globalTheme } from '../../core/model/use-theme-model';
	import AppTabBar from '@/components/app-tab-bar/app-tab-bar.uvue';

	onMounted(() => {
		uni.hideTabBar();
	});

	// 真实用户数据（UTS: computed 必须显式返回类型）
	const nickname = computed((): string => {
		const user = globalUser.currentUser;
		if (user == null) return '朋友';
		if (user.nickname == '') return '朋友';
		return user.nickname as string;
	});

	const greetingText = computed((): string => {
		return '你好，';
	});

	const dateText = computed((): string => {
		return '今天';
	});

	// 快捷入口数据
	type QuickItem = {
		icon: string;
		title: string;
		desc: string;
		gradient: string;
	}
	const quickList = ref<QuickItem[]>([
		{ icon: '📷', title: '拍照记录', desc: '随手拍', gradient: 'linear-gradient(135deg, #3c86fe, #6c5ce7)' },
		{ icon: '📁', title: '我的物品', desc: '12件', gradient: 'linear-gradient(135deg, #ff9f43, #ee5a24)' },
		{ icon: '🎨', title: '模型库', desc: '8个', gradient: 'linear-gradient(135deg, #00b894, #00cec9)' },
		{ icon: '⭐', title: '收藏夹', desc: '5个', gradient: 'linear-gradient(135deg, #e17055, #d63031)' },
	]);

	// 最近记录数据
	type RecentItem = {
		title: string;
		category: string;
		date: string;
		emoji: string;
		gradient: string;
	}
	const recentList = ref<RecentItem[]>([
		{ title: '机械键盘', category: '数码', date: '2小时前', emoji: '⌨️', gradient: 'linear-gradient(135deg, #2d3436, #636e72)' },
		{ title: '山地自行车', category: '运动', date: '昨天', emoji: '🚲', gradient: 'linear-gradient(135deg, #0984e3, #74b9ff)' },
		{ title: '吉他', category: '乐器', date: '3天前', emoji: '🎸', gradient: 'linear-gradient(135deg, #6c5ce7, #a29bfe)' },
		{ title: '咖啡机', category: '家电', date: '1周前', emoji: '☕', gradient: 'linear-gradient(135deg, #d63031, #e17055)' },
	]);

	watch(
		globalUser.isLogin,
		(loggedIn: boolean) => {
			if (loggedIn === false) {
				uni.reLaunch({ url: '/pages/login/login' });
			}
		},
	);
</script>

